# ---------------------------------------------------------------------------
# Secrets and local configuration
#
# .env holds the GitLab OAuth secret and the group access token once this is
# pointed at a real instance. It must never be tracked — commit .env.example
# instead and let each machine keep its own copy.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Django collects these at deploy time and writes uploads at runtime.
backend/staticfiles/
backend/media/
*.sqlite3

# ---------------------------------------------------------------------------
# Node and Next.js
# ---------------------------------------------------------------------------
node_modules/
.next/
out/
build/
.turbo/
.vercel/
*.tsbuildinfo

# Regenerated by Next on every dev run and build.
next-env.d.ts

# ---------------------------------------------------------------------------
# Logs and runtime noise
# ---------------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pids/
*.pid

# ---------------------------------------------------------------------------
# Editors and operating systems
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# ---------------------------------------------------------------------------
# Local tool state
#
# .claude/settings.json is shared project configuration and stays tracked;
# the .local variant is per-developer.
# ---------------------------------------------------------------------------
.claude/settings.local.json

# ---------------------------------------------------------------------------
# Local extraction of reference.zip. The archive itself stays tracked, so the
# material is preserved without carrying a second application in the tree.
# ---------------------------------------------------------------------------
/reference/
