# SloMo backend configuration (pydantic-settings, prefix SLOMO_)

# Auth — single local bearer token shared with the frontend
SLOMO_AUTH_TOKEN=change-me

# Paths
SLOMO_WORKSPACE_DIR=/home/soham/workspace
SLOMO_DATA_DIR=/home/soham/.slomo/db
SLOMO_LOG_DIR=/home/soham/.slomo/logs

# Claude Code sessions
SLOMO_CLAUDE_BIN=claude
SLOMO_MAX_CLAUDE_SESSIONS=3

# SloMo agent LLM (LangGraph planner/router/reply). Without a key the agent
# runs in degraded heuristic mode.
SLOMO_AGENT_MODEL=claude-sonnet-5
SLOMO_ANTHROPIC_API_KEY=

# Gemini Live (voice). Key never leaves the backend; the browser gets
# short-lived ephemeral tokens from /api/gemini/token.
SLOMO_GEMINI_API_KEY=
SLOMO_GEMINI_LIVE_MODEL=models/gemini-3.1-flash-live-preview

# Langfuse (optional; self-hosted on LAN preferred)
SLOMO_LANGFUSE_PUBLIC_KEY=
SLOMO_LANGFUSE_SECRET_KEY=
SLOMO_LANGFUSE_HOST=http://localhost:3001

# CORS (JSON list)
SLOMO_CORS_ORIGINS=["http://localhost:3000","http://slomo.local:3000"]
