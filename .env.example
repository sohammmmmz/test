DEBUG=true
DJANGO_SECRET_KEY=change-me-in-production
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pms

# GitLab OAuth application (scopes: api read_user)
GITLAB_URL=https://gitlab.com
GITLAB_OAUTH_CLIENT_ID=
GITLAB_OAUTH_CLIENT_SECRET=
GITLAB_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/gitlab/callback

# Group access token with `api` scope + the group new repos are created under
GITLAB_SERVICE_TOKEN=
GITLAB_GROUP_ID=

FRONTEND_URL=http://localhost:3000
BACKEND_INTERNAL_URL=http://localhost:8000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Working rhythm
WORKING_WEEKDAYS=0,1,2,3,4
TODO_STALE_AFTER_DAYS=3

# ---------------------------------------------------------------------------
# Copy this to .env and fill in the GitLab values before starting Django.
#
#   GITLAB_OAUTH_CLIENT_ID / _SECRET  an OAuth application with the `api` and
#                                     `read_user` scopes. `read_api` is not
#                                     enough — it cannot create milestones,
#                                     issues, branches or memberships.
#   GITLAB_SERVICE_TOKEN              a group access token with `api`. Performs
#                                     every write, so nothing shared depends on
#                                     one person staying signed in.
#   GITLAB_GROUP_ID                   the group new repositories are created in.
# ---------------------------------------------------------------------------
