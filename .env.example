DEBUG=true
DJANGO_SECRET_KEY=change-me-in-production
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pms

# Cache. Leave REDIS_URL blank and the app falls back to per-process local
# memory — everything still works, it is just not shared between workers. Set it
# for anything with more than one person using it.
REDIS_URL=redis://localhost:6379/0
# REDIS_KEY_PREFIX=          # only needed if the Redis is shared with something else

# How long a cached read may be stale if nothing invalidates it first. Writes
# invalidate immediately, so these only matter for changes made outside this app.
CACHE_TTL_DASHBOARD=60
CACHE_TTL_LIST=120
CACHE_TTL_PLAN=120
CACHE_TTL_DAY=30

# Opening a project re-reads GitLab in the background. This is how often that
# is allowed to actually happen per project; the Sync button ignores it.
RECONCILE_THROTTLE_SECONDS=90

# GitLab OAuth application (scopes: api read_user)
GITLAB_URL=https://gitlab.com
GITLAB_OAUTH_CLIENT_ID=
GITLAB_OAUTH_CLIENT_SECRET=
GITLAB_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/gitlab/callback

# Group access token with `api` scope + the group new repos are created under
GITLAB_SERVICE_TOKEN=
GITLAB_GROUP_ID=

FRONTEND_URL=http://localhost:3000
BACKEND_INTERNAL_URL=http://localhost:8000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Working rhythm
WORKING_WEEKDAYS=0,1,2,3,4
TODO_STALE_AFTER_DAYS=3
# What one person comfortably holds at once. Used only to express
# bandwidth as a percentage in the reports.
CAPACITY_OPEN_ITEMS=8

# ---------------------------------------------------------------------------
# Copy this to .env and fill in the GitLab values before starting Django.
#
#   GITLAB_OAUTH_CLIENT_ID / _SECRET  an OAuth application with the `api` and
#                                     `read_user` scopes. `read_api` is not
#                                     enough — it cannot create milestones,
#                                     issues, branches or memberships.
#   GITLAB_SERVICE_TOKEN              a group access token with `api`. Performs
#                                     every write, so nothing shared depends on
#                                     one person staying signed in.
#   GITLAB_GROUP_ID                   the group new repositories are created in.
# ---------------------------------------------------------------------------
